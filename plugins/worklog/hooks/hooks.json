{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "worklog session-start" },
          { "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/check-update.sh\"" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "worklog session-end" }
        ]
      }
    ]
  }
}
