{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "worklog session-start" },
          { "type": "command", "command": "worklog update --auto" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "worklog session-end" }
        ]
      }
    ]
  }
}
